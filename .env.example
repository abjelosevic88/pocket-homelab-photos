TZ=Europe/Berlin
BASE_URL=https://photos.example.com
# Start the Immich that comes with Pocket Photos (server, machine learning, database,
# Redis). Remove this line (and run `docker compose stop immich-server immich-machine-learning
# immich-redis immich-database`) to use your own Immich at IMMICH_URL instead.
COMPOSE_PROFILES=immich
# The bundled Immich's database password (set it once, before the first start)
DB_PASSWORD=change-me-please
# Where photos and videos are kept (default: photos next to this file), and Immich's database (local disk)
# PHOTOS_FOLDER=/srv/photos
# IMMICH_DB_DIR=./immich/postgres
# Your own Immich:
# IMMICH_URL=http://immich-server:2283
# Where sharing links open in a browser (Immich's public address)
# IMMICH_PUBLIC_URL=https://immich.example.com
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=change-me-please
# SECURE_COOKIES=true
# CORE_URL=http://pocket-core:8080
# CORE_REGISTRATION_KEY=
# Clouds that sign in with OAuth (docs/clouds.md) need your own client registration:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
